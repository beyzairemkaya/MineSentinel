# ==============================================================================
# MineSentinel Environment Configuration Template
# Copy this file to '.env' and fill in your operational credentials.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO VERSION CONTROL.
# ==============================================================================

# LLM Incident Report Generation (Groq API)
# Obtain your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Telemetry Ingestion Core & Backend Routing
# Default local development port is 8000
BACKEND_URL=http://localhost:8000

# Server Binding Configuration (FastAPI / Uvicorn)
HOST=0.0.0.0
PORT=8000